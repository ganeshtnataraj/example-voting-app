pipeline {
    options {
        ansiColor('xterm')
        buildDiscarder(
            logRotator(
                numToKeepStr: '10',
                artifactNumToKeepStr: '10'
            )
        )
    }

    agent any

    parameters {
        string(name: 'BRANCH_NAME', defaultValue: '', description: 'Git branch to build')
    }

    environment {
        IMAGE_NAME = "ganeshtn91/voting-app" // Docker image name
        KUBECONFIG_FILE = credentials('kubeconfig-file')
    }

    stages {

        stage('Checkout Code') {
            steps {
                dir('vote') {
                    script {
                        def ref = params.BRANCH_NAME ?: 'feature_b_example-voting-app'
                        echo "Checking out Git ref: ${ref}"

                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: ref.startsWith('refs/') ? ref : "*/${ref}"]],
                            userRemoteConfigs: [[
                                url: 'git@github.com:ganeshtnataraj/example-voting-app.git',
                                credentialsId: 'github-ssh-key-id'
                            ]]
                        ])

                        env.SHORT_COMMIT = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                        echo "Checked out commit: ${env.SHORT_COMMIT}"
                    }
                }
            }
        }

        stage("Build Name") {
            steps {
                script {
                    currentBuild.displayName = "BRANCH: ${env.BRANCH_NAME ?: 'main'} | COMMIT: ${env.SHORT_COMMIT}"
                }
            }
        }

        stage("Docker Build") {
            steps {
                script {
                    sh """
                        export PATH=/usr/local/bin:$PATH
                        docker --version
                        echo "Building Docker image..."
                        docker build -t ${env.IMAGE_NAME}:${env.SHORT_COMMIT} ./vote
                    """
                    echo "Docker Image Built: ${env.IMAGE_NAME}:${env.SHORT_COMMIT}"
                }
            }
        }

        stage("Docker Push") {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-cred-id', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh """
                        export PATH=/usr/local/bin:$PATH
                        docker --version
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        docker push ${env.IMAGE_NAME}:${env.SHORT_COMMIT}
                    """
                }
            }
        }
        stage('Set KUBECONFIG File') {
            steps{
                script{
                    // Conditionally set KUBECONFIG based on parameters
                        env.KUBECONFIG = KUBECONFIG_FILE
                        echo "Using KUBECONFIG: ${env.KUBECONFIG}"
                }
            }
        }

        stage('Install helm') {
            steps{
                sh'''
                    export PATH=/opt/homebrew/bin:$PATH
                    helm version
                    #HELM UPGRADE
                    helm upgrade --install --atomic --wait --timeout 15m --namespace test voting-app deployment_code/helm/voting-app -f deployment_code/helm/voting-app/values.yaml --set image_tag=$SHORT_COMMIT
                        
                    helm_status=$(helm status voting-app --namespace test | grep -i "status" | awk -F " " '{print $2}')
                '''
            }

        }
    }

    post {
        always {
            echo "Cleaning workspace..."
            cleanWs()
        }
        success {
            echo "voting app deployed completed successfully ✅"
        }
        failure {
            echo "voting app deployment failed ❌"
        }
    }
}